# Copia este archivo a .env y rellena los valores del entorno que uses.
# .env está en .gitignore: nunca subas credenciales al repositorio.

# development | test | staging | production
EXPO_PUBLIC_ENTORNO=development

# Proyecto de Supabase. Cada entorno tiene el suyo, con claves separadas.
# La clave anónima está pensada para vivir en el cliente y va siempre
# acompañada de RLS. La clave de servicio NUNCA se pone aquí ni en el cliente.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
